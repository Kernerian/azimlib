include LICENSE README.md CHANGELOG.md
include NOTICE_COLORMAPS
include THIRD_PARTY_LICENSES.md
recursive-include licenses *.txt *.json
include .gitattributes
include .github/workflows/tests.yml
recursive-include docs *.md *.json
recursive-include examples *.py
recursive-include examples *.mplstyle
recursive-include tests *.py
recursive-include src/azimlib/data *.json *.geojson.gz
recursive-include src/azimlib/assets *.js *.css
recursive-include src/azimlib/assets/icons *.png *.svg *.json
recursive-include tools *.py *.md *.js
recursive-include tools/baselines/layout-acceptance-before *.json
recursive-include tools/baselines/ci-portability-before *.json *.yml
recursive-include src/azimlib/fonts *.ttf *.json *.md LICENSE_DEJAVU

include CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md
include .github/workflows/publish.yml
recursive-include docs/_static *.png
recursive-include docs/_static/terrain3d *.svg *.pdf *.html
recursive-include docs/_static/temporal *.svg *.pdf *.gif

# Optional derivative databases retain separate licenses outside Python archives.
prune optional-data
