# Reproducible Python source/geometry hashes, even with core.autocrlf=true.
* text=auto eol=lf
.gitattributes text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
# Historical measured byte snapshots and bundled resources must stay exact.
tools/baselines/** -text
src/azimlib/assets/** -text
src/azimlib/fonts/** -text
src/azimlib/data/** -text

# Versioned optional payload/license hashes preserve exact bytes on every platform.
optional-data/** -text

# Binary exports must keep stream offsets and embedded legal notices exact.
*.pdf binary
*.png binary
*.gif binary
